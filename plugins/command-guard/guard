#!/bin/sh
# command-guard (Unix): veto run_shell_command matching destructive patterns.
# Contract: `guard <event> <tool_name>` + event JSON on stdin; first stdout
# line decides: "allow" | "veto <reason>".
[ "$2" = "run_shell_command" ] || { echo "allow"; exit 0; }

json=$(cat)
cmd=$(printf '%s' "$json" | sed -n 's/.*"command"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
[ -n "$cmd" ] || { echo "allow"; exit 0; }

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
patterns_file="$SCRIPT_DIR/patterns.txt"
[ -f "$patterns_file" ] || { echo "allow"; exit 0; }

while IFS= read -r p; do
  case "$p" in
    ''|'#'*) continue ;;
  esac
  if printf '%s' "$json" | grep -qiE -- "$p"; then
    echo "veto destructive command: $cmd"
    exit 0
  fi
done < "$patterns_file"

echo "allow"
exit 0
